<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Portfolio de Tu Nombre — Desarrollador Fullstack" />
  <title>Tu Nombre — Dev</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;1,9..40,300&display=swap" rel="stylesheet" />

  <style>
    /* ── Variables ── */
    :root {
      --bg:        #0d0d0d;
      --bg2:       #141414;
      --surface:   #1a1a1a;
      --border:    #262626;
      --muted:     #555;
      --text:      #e8e8e8;
      --accent:    #7fff7f; /* ← cambia tu color de acento aquí */
      --font-mono: 'DM Mono', monospace;
      --font-sans: 'DM Sans', sans-serif;
    }

    /* ── Reset ── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-sans);
      font-size: 15px;
      line-height: 1.7;
      min-height: 100vh;
    }

    a { color: inherit; text-decoration: none; }
    img { display: block; max-width: 100%; }

    /* ── Layout ── */
    .wrapper {
      max-width: 680px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* ── Nav ── */
    nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(13,13,13,0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
    }

    nav .wrapper {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 52px;
    }

    .nav-logo {
      font-family: var(--font-mono);
      font-size: 13px;
      color: var(--muted);
      letter-spacing: 0.02em;
    }

    .nav-logo span { color: var(--accent); }

    .nav-links {
      display: flex;
      gap: 4px;
    }

    .nav-links a {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--muted);
      padding: 6px 10px;
      border-radius: 6px;
      transition: color .2s, background .2s;
    }

    .nav-links a:hover,
    .nav-links a.active {
      color: var(--text);
      background: var(--surface);
    }

    /* ── Sections ── */
    section {
      padding: 80px 0;
      border-bottom: 1px solid var(--border);
      opacity: 0;
      transform: translateY(20px);
      transition: opacity .5s ease, transform .5s ease;
    }

    section.visible {
      opacity: 1;
      transform: translateY(0);
    }

    section:last-of-type { border-bottom: none; }

    /* ── Hero ── */
    #hero {
      padding-top: 100px;
      padding-bottom: 100px;
    }

    .hero-greeting {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--accent);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 20px;
    }

    .hero-name {
      font-size: clamp(2rem, 6vw, 3.2rem);
      font-weight: 300;
      letter-spacing: -0.02em;
      line-height: 1.1;
      margin-bottom: 12px;
    }

    .hero-name strong {
      font-weight: 400;
      /* cambia el nombre aquí */
    }

    .hero-title {
      font-family: var(--font-mono);
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 28px;
    }

    .hero-title .tag {
      display: inline-block;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 2px 8px;
      margin: 2px 4px 2px 0;
      font-size: 11px;
      color: var(--muted);
    }

    .hero-bio {
      font-size: 15px;
      color: #aaa;
      max-width: 480px;
      margin-bottom: 36px;
      line-height: 1.8;
    }

    .hero-bio a {
      color: var(--text);
      border-bottom: 1px solid var(--border);
      transition: border-color .2s, color .2s;
    }

    .hero-bio a:hover {
      color: var(--accent);
      border-color: var(--accent);
    }

    .hero-cta {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: var(--font-mono);
      font-size: 12px;
      padding: 10px 18px;
      border-radius: 8px;
      transition: all .2s;
      cursor: pointer;
      border: none;
    }

    .btn-primary {
      background: var(--accent);
      color: #000;
      font-weight: 500;
    }

    .btn-primary:hover { filter: brightness(1.1); }

    .btn-ghost {
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
    }

    .btn-ghost:hover {
      border-color: var(--muted);
      background: #222;
    }

    /* ── Section titles ── */
    .section-label {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      margin-bottom: 36px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .section-label::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border);
    }

    /* ── Projects ── */
    .projects-grid {
      display: flex;
      flex-direction: column;
      gap: 1px;
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
    }

    .project-card {
      background: var(--bg2);
      padding: 22px 24px;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      transition: background .2s;
      cursor: pointer;
      border-bottom: 1px solid var(--border);
      text-decoration: none;
      color: inherit;
    }

    .project-card:last-child { border-bottom: none; }
    .project-card:hover { background: var(--surface); }

    .project-left { flex: 1; min-width: 0; }

    .project-name {
      font-size: 14px;
      font-weight: 400;
      margin-bottom: 4px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .project-name .dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--accent);
      flex-shrink: 0;
    }

    .project-desc {
      font-size: 13px;
      color: var(--muted);
      line-height: 1.6;
    }

    .project-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 10px;
    }

    .project-tag {
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--muted);
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 2px 7px;
    }

    .project-arrow {
      font-size: 18px;
      color: var(--border);
      flex-shrink: 0;
      margin-top: 2px;
      transition: color .2s, transform .2s;
    }

    .project-card:hover .project-arrow {
      color: var(--accent);
      transform: translate(2px, -2px);
    }

    /* ── About ── */
    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-top: 28px;
    }

    .about-card {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 20px;
    }

    .about-card-title {
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 10px;
    }

    .about-card ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .about-card ul li {
      font-size: 13px;
      color: #bbb;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .about-card ul li::before {
      content: '›';
      color: var(--accent);
      font-size: 16px;
      line-height: 1;
    }

    .about-bio {
      font-size: 14px;
      color: #999;
      line-height: 1.8;
      margin-bottom: 20px;
    }

    /* ── Contact ── */
    .contact-links {
      display: flex;
      flex-direction: column;
      gap: 1px;
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
    }

    .contact-link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      background: var(--bg2);
      border-bottom: 1px solid var(--border);
      transition: background .2s;
      color: inherit;
    }

    .contact-link:last-child { border-bottom: none; }
    .contact-link:hover { background: var(--surface); }

    .contact-link-left {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .contact-icon {
      width: 32px;
      height: 32px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
    }

    .contact-label {
      font-size: 13px;
      color: var(--text);
    }

    .contact-value {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--muted);
      margin-top: 2px;
    }

    .contact-arrow {
      font-size: 16px;
      color: var(--border);
      transition: color .2s;
    }

    .contact-link:hover .contact-arrow { color: var(--accent); }

    /* ── Footer ── */
    footer {
      padding: 32px 0;
      text-align: center;
    }

    footer p {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--muted);
    }

    footer span { color: var(--accent); }

    /* ── Cursor blink ── */
    .cursor {
      display: inline-block;
      width: 2px;
      height: 1em;
      background: var(--accent);
      margin-left: 4px;
      vertical-align: middle;
      animation: blink 1s step-end infinite;
    }

    @keyframes blink {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0; }
    }

    /* ── Responsive ── */
    @media (max-width: 520px) {
      .about-grid { grid-template-columns: 1fr; }
      .hero-cta { flex-direction: column; }
      .btn { justify-content: center; }
    }
  </style>
</head>
